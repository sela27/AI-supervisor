# What one deployment of the Supervisor differs by. Copy to .env and fill in —
# .env is never committed. What the instance *is* goes in supervisor.config.json.

# The project the Supervisor minds: an absolute path to a git clone on this
# machine, with a remote it may push to. The only one it is given.
SUPERVISOR_PROJECT_DIR=/absolute/path/to/your/project

# Where the Claude credentials the nights run on are kept. A directory of its
# own, not the one you log in with yourself. Make it yourself before the first
# `docker compose up` — one Docker has to create is created as root, and the
# container is not root.
SUPERVISOR_CLAUDE_DIR=./claude

# Who the Checkpoints are committed under, when the project's own clone has not
# already said.
SUPERVISOR_GIT_NAME=AI Supervisor
SUPERVISOR_GIT_EMAIL=ai-supervisor@localhost

# A token for the repository, with permission to read and write issues and to
# push. Only needed by a queue whose tickets are GitHub issues, or a project
# whose Checkpoints are pushed to GitHub.
GH_TOKEN=

# Which port on this machine the dashboard answers on.
SUPERVISOR_HOST_PORT=4317

# Who the container runs as. On a Linux host this has to be whoever owns the
# project and the credentials directory — `id -u` and `id -g` say. On macOS and
# Windows the defaults are right, because the mounts are not owned by anybody in
# particular there.
SUPERVISOR_UID=1000
SUPERVISOR_GID=1000

# Left empty, the Claude Code executable picks its own model.
SUPERVISOR_MODEL=

SUPERVISOR_LOG_LEVEL=info
